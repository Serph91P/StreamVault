{
  "name": "streamvault-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_USE_MOCK_DATA=true vite",
    "dev:live": "VITE_USE_MOCK_DATA=false vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "lint:tokens": "node scripts/check-design-tokens.cjs",
    "format": "prettier --write src/",
    "update-browsers": "npx update-browserslist-db@latest"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "hls.js": "^1.6.16",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "axe-core": "^4.12.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "npm-run-all2": "^9.0.3",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.9"
  },
  "overrides": {
    "serialize-javascript": "^7.0.3",
    "vite-plugin-pwa": {
      "vite": "$vite"
    },
    "@babel/core": "7.29.7",
    "fast-uri": "3.1.4",
    "immutable": "5.1.9",
    "shell-quote": "1.10.0",
    "brace-expansion@5": "5.0.8",
    "jake": "12.10.1"
  }
}
