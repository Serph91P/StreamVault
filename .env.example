# Copy this file to .env for local development. Do not commit .env files.
# Replace placeholders through your deployment's secret-management process.
TWITCH_APP_ID=replace_with_twitch_application_id
TWITCH_APP_SECRET=replace_with_twitch_application_secret
BASE_URL=https://streamvault.example.com
EVENTSUB_SECRET=replace_with_a_random_secret
# Optional override: inject AUTH_JWT_SECRET (32+ characters) through secret management.
# When omitted, StreamVault creates and persists a unique JWT signing identity.
POSTGRES_USER=streamvault
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=streamvault
TZ=UTC
